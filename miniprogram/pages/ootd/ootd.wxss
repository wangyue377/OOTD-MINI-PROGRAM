.sun-glow {
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 导航切换 */
.nav-container { padding: 20rpx 40rpx; }
.tab-wrapper {
  display: flex;
  background: rgba(241, 245, 249, 0.9);
  border-radius: 40rpx;
  padding: 8rpx;
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748B;
  border-radius: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.tab-btn.active {
  background: #1E3A8A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.2);
}
.icon-mini { margin-right: 8rpx; }

/* 标题区 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx 30rpx;
}
.main-title { font-size: 48rpx; font-weight: 800; color: #1E293B; }
.sub-title { font-size: 24rpx; color: #94A3B8; display: block; margin-top: 4rpx; }
.weather-badge {
  background: #FFFFFF;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
}
.temp { font-size: 32rpx; font-weight: 700; color: #1E293B; margin-right: 8rpx; }

/* 卡片通用 */
.content-padding { padding: 0 40rpx 60rpx; }
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 30rpx;
  border: 1rpx solid #F8FAFC;
}
.shadow-sm { box-shadow: 0 10rpx 20rpx -5rpx rgba(0, 0, 0, 0.04); }
.mt-3 { margin-top: 24rpx; }

.card-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.card-icon { font-size: 28rpx; margin-right: 12rpx; }
.card-title { font-size: 24rpx; font-weight: 700; color: #1E293B; }

/* 天气详情 */
.weather-detail { display: flex; justify-content: space-around; align-items: center; padding: 10rpx 0; }
.detail-item { text-align: center; }
.detail-val { font-size: 28rpx; font-weight: 700; color: #1E293B; display: block; }
.detail-lab { font-size: 20rpx; color: #94A3B8; margin-top: 4rpx; }
.detail-line { width: 1rpx; height: 40rpx; background: #F1F5F9; }

/* 7日预报 */
.forecast-x { white-space: nowrap; width: 100%; }
.forecast-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #F8FAFC;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.fc-day { font-size: 20rpx; color: #64748B; margin-bottom: 8rpx; }
.fc-icon { font-size: 32rpx; margin: 8rpx 0; }
.fc-temp { font-size: 24rpx; font-weight: 600; color: #1E293B; }

/* 风格标签容器 */
.style-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 12rpx;
  margin: 20rpx 0 10rpx 0;
  padding: 0 4rpx;
}

.style-pill {
  padding: 10rpx 24rpx;
  background: #F8FAFC;
  border: 2rpx solid #F1F5F9;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #64748B;
  transition: all 0.2s ease;
}

.style-pill.active {
  background: #EFF6FF;
  border-color: #1E3A8A;
  color: #1E3A8A;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.1);
}

/* 按钮区域容器：增加了上边距和细分割线 */
.generate-section {
  margin-top: 40rpx; 
  border-top: 1rpx solid #F8FAFC; /* 增加一条极淡的分割线 */
  padding-top: 30rpx;
}

.style-desc {
  font-size: 22rpx;
  color: #94A3B8;
  padding-left: 8rpx;
  margin-bottom: 24rpx; /* 拉开与按钮的距离 */
}

.highlight {
  color: #1E3A8A;
  font-weight: 700;
}

.mt-3 { margin-top: 30rpx !important; }
.mt-4 { margin-top: 40rpx !important; }

/* 按钮本身样式保持原有风格 */
.magic-btn {
  background: #1E3A8A;
  color: #fff;
  border-radius: 100rpx;
  font-weight: 600;
}

.magic-icon { margin-right: 12rpx; }
.btn-hover { opacity: 0.9; transform: scale(0.98); }


/* 原有样式保留，添加以下部分 */

.fc-temp {
  font-size: 24rpx;
  font-weight: 600;
  color: #1E293B;
  margin: 8rpx 0;
}

.fc-icon-small {
  font-size: 36rpx;
  margin-top: 4rpx;
}

.forecast-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #F8FAFC;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  min-width: 140rpx;
}

.fc-day {
  font-size: 20rpx;
  color: #94A3B8;
}