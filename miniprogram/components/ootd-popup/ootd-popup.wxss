.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
  display: flex;
  align-items: flex-end;
}
.modal-mask.show { visibility: visible; opacity: 1; }

.popup-container {
  width: 100%;
  height: 88vh;
  background: #FFFFFF;
  border-radius: 56rpx 56rpx 0 0;
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 0 40rpx;
  box-sizing: border-box;
}
.modal-mask.show .popup-container { transform: translateY(0); }

.drag-handle {
  width: 80rpx;
  height: 8rpx;
  background: #E2E8F0;
  border-radius: 4rpx;
  margin: 20rpx auto 30rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.h3 { font-size: 36rpx; font-weight: 800; color: #1E293B; }
.info-tags { display: flex; align-items: center; gap: 16rpx; margin-top: 8rpx; }
.tag-pill {
  background: #EFF6FF;
  color: #1E3A8A;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.info-text { font-size: 20rpx; color: #94A3B8; }

.close-icon-btn {
  width: 70rpx; height: 70rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.close-x { color: #64748B; font-size: 24rpx; }

.ai-box {
  background: #F8FAFC;
  border: 1rpx solid #F1F5F9;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}
.ai-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #94A3B8;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.robot-icon { margin-right: 8rpx; }
.ai-content { font-size: 22rpx; color: #475569; line-height: 1.5; }

.display-area { flex: 1; }
.display-title { font-size: 28rpx; font-weight: 700; color: #1E293B; margin-bottom: 16rpx; display: block; }
.ootd-swiper {
  height: 750rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.1);
}
.outfit-img { width: 100%; height: 100%; }
.hint-text {
  text-align: center;
  display: block;
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 16rpx;
}
.safe-bottom-holder { height: env(safe-area-inset-bottom); padding-bottom: 20rpx; }