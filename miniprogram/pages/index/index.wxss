/** 首次使用引导 · 对齐 onboarding.html */

page {
  height: 100%;
  background: linear-gradient(165deg, #c5dcff 0%, #e8f2ff 45%, #f8fbff 100%);
}

.page {
  width: 100%;
  height: 100%;
}

.screen {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
}

/* ===== 欢迎页 ===== */
.welcome {
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: 48rpx;
  background: linear-gradient(165deg, #c5dcff 0%, #e8f2ff 45%, #f8fbff 100%);
  overflow: hidden;
}

.rings {
  position: absolute;
  top: -200rpx;
  left: -140rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 0 72rpx rgba(255, 255, 255, 0.15), 0 0 0 144rpx rgba(255, 255, 255, 0.08);
}

.welcome-sun {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background-color: #ffb347;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 179, 71, 0.45);
}

.icon-sun {
  font-size: 44rpx;
  line-height: 1;
}

.welcome-main {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 40%;
  transform: translateY(-50%);
  text-align: center;
  z-index: 2;
}

.welcome-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.welcome-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

.welcome-clouds {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 200rpx;
  height: 120rpx;
  z-index: 2;
}

.cloud {
  position: absolute;
  line-height: 1;
}

.cloud-a {
  font-size: 76rpx;
  left: 22%;
  bottom: 0;
  opacity: 0.85;
  animation: floatY 4s ease-in-out infinite;
}

.cloud-b {
  font-size: 60rpx;
  right: 22%;
  bottom: 16rpx;
  opacity: 0.75;
  animation: floatX 5s ease-in-out infinite;
}

.welcome-foot {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 48rpx;
  z-index: 3;
}

/* ===== 引导 Sheet ===== */
.guide-overlay {
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.guide-panel {
  width: 100%;
  background-color: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
  max-height: 82%;
}

.guide-bar {
  width: 64rpx;
  height: 8rpx;
  background-color: #e2e8f0;
  border-radius: 8rpx;
  margin: 0 auto 24rpx;
}

.guide-h1 {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.guide-p {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: #64748b;
  letter-spacing: 1rpx;
}

.field-box {
  margin-top: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #f8fafc;
  border: 2rpx solid #f1f5f9;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.field-ico {
  font-size: 28rpx;
  line-height: 1;
  margin-right: 12rpx;
}

.field-inp {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
  height: 40rpx;
  min-height: 40rpx;
}

.field-area {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #0f172a;
  line-height: 1.5;
}

.gender-wrap {
  margin-top: 12rpx;
}

.gender-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  margin-right: 16rpx;
  border-radius: 24rpx;
  border: 4rpx solid #f1f5f9;
  background-color: #fff;
  font-size: 28rpx;
  color: #334155;
}

.gender-btn:last-child {
  margin-right: 0;
}

.gender-on {
  border-color: #1e3a8a;
  background-color: #eff6ff;
  color: #1e3a8a;
}

.field-btn {
  margin-top: 32rpx;
}

/* ===== 按钮 ===== */
.btn-main {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  padding: 0 !important;
  border-radius: 999rpx !important;
  background-color: #1e3a8a !important;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: none !important;
  box-shadow: 0 12rpx 40rpx rgba(30, 58, 138, 0.28);
}

.btn-main::after {
  border: none;
}

/* ===== 动画 ===== */
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

@keyframes floatX {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(12rpx); }
}

/* ===== 完成页 · 严格中线对齐 + 适中间距 ===== */
.done {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: linear-gradient(165deg, #c5dcff 0%, #e8f2ff 45%, #f8fbff 100%);
}

/* 核心修复：图标垂直中线对齐 */
.done-ico {
  font-size: 88rpx;
  line-height: 1;
  vertical-align: middle;
  display: block;
  text-align: center;
}

/* 核心修复：文字严格居中，无偏移 */
.done-title {
  display: block;
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
  line-height: 1.2;
  vertical-align: middle;
}

.done-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.2;
  vertical-align: middle;
}

/* 按钮文字完美居中 */
.btn-reset {
  margin-top: 48rpx;
  width: 80%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #1e3a8a;
  color: #1e3a8a;
  font-size: 28rpx;
  font-weight: 500;
  /* 终极居中：flex+垂直水平居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 138, 0.12);
}

.btn-reset::after {
  border: none;
}