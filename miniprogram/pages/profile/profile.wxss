/* 背景渐变效果 */
.sun-glow {
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 导航切换 */
.nav-container {
  padding: 20rpx 40rpx;
}

.tab-wrapper {
  display: flex;
  background: rgba(241, 245, 249, 0.9);
  border-radius: 40rpx;
  padding: 8rpx;
}

.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748B;
  border-radius: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tab-btn.active {
  background: #1E3A8A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(30, 58, 138, 0.2);
}

.icon-mini {
  margin-right: 8rpx;
}

/* 标题栏 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 20rpx 40rpx 40rpx;
}

.main-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #1E293B;
  line-height: 1;
}

.sub-title {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

.round-menu-btn {
  width: 72rpx;
  height: 72rpx;
  background: #FFFFFF;
  border: 1rpx solid #F1F5F9;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 卡片样式 */
.form-container {
  padding: 0 40rpx 60rpx;
}

.input-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #F8FAFC;
  box-shadow: 0 10rpx 20rpx -5rpx rgba(0, 0, 0, 0.04);
}

.field-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #94A3B8;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 16rpx;
}

.input-row {
  display: flex;
  align-items: center;
}

.field-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #1E293B;
  font-weight: 500;
}

/* 性别选择器 */
.gender-selector {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 24rpx;
  border: 4rpx solid #F1F5F9;
  font-size: 28rpx;
  color: #64748B;
  transition: all 0.2s;
}

.gender-option.active {
  border-color: #1E3A8A;
  background: #EFF6FF;
  color: #1E3A8A;
  font-weight: 600;
}

.field-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.6;
}

/* 保存按钮 */
.submit-btn {
  background: #1E3A8A !important;
  color: #FFFFFF !important;
  border-radius: 100rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  padding: 24rpx 0 !important;
  margin-top: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(30, 58, 138, 0.3);
}

.btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}